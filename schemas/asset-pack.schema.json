{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://studio.corosolto.com.br/schemas/asset-pack-v1.json",
  "title": "Coro Solto Studio Asset Pack",
  "type": "object",
  "required": ["schemaVersion", "kind", "id", "version", "source", "files"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "enum": ["map", "character", "viewmodel", "skin"] },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "source": {
      "type": "object",
      "required": ["revision", "provenance"],
      "properties": {
        "revision": { "type": "string", "minLength": 7 },
        "provenance": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256", "bytes"],
        "properties": {
          "path": { "type": "string", "pattern": "^(?!/)(?!.*\\.\\.)[^\\\\]+$" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "bytes": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "budgets": { "type": "object" },
    "previews": { "type": "array", "items": { "type": "string" } },
    "evidence": { "type": "array", "items": { "type": "string" } }
  }
}
